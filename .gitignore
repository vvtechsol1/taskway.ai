# Local database (auto-created on first run; keep your data private)
/data/*.sqlite
/data/*.sqlite-wal
/data/*.sqlite-shm

# Logs & OS cruft
*.log
.DS_Store
Thumbs.db
desktop.ini

# Editor
.vscode/
.idea/

# Claude Code local settings
.claude/

# Uploaded chat media (keep the folders, not the files)
uploads/chat/*
!uploads/chat/.gitkeep
